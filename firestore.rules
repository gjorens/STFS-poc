rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can only read and write their own documents.
    match /users/{uid}/docs/{docId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['title', 'body', 'device', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.title.size() < 300
        && request.resource.data.body.size() < 900000;
    }
  }
}
